# ── Production environment — cur.ac.rw/umis ────────────────────────────────
# This file is loaded by Vite ONLY during `npm run build`.
# It is never committed — add to .gitignore if not already there.

# Full URL of the backend API (no trailing slash)
VITE_API_URL=https://cur.ac.rw/umis/api/api

# Sub-folder base for the React app and React Router (no trailing slash)
VITE_BASE_PATH=/umis

VITE_APP_NAME=CUR-MIS
VITE_APP_VERSION=1.0.0

# Axios request timeout (ms)
VITE_API_TIMEOUT=15000

# localStorage key used by Zustand auth persist middleware
VITE_AUTH_STORAGE_KEY=cur-mis-auth

# API docs link — disabled in production (AuthLayout only shows it in dev mode)
VITE_API_DOCS_URL=https://cur.ac.rw/umis/api/api-docs.php
