# During development, Vite proxies /api/* to the backend automatically.
# Leave blank to use the proxy (recommended for dev).
# In production, set this to your cPanel backend URL:
# VITE_API_URL=https://yourdomain.com/backend/public
VITE_API_URL=http://localhost:8888/cur-mis/backend/public

VITE_APP_NAME=CUR-MIS
VITE_APP_VERSION=0.1.0

# Local MAMP port (read by vite.config.ts at build/dev time — NOT exposed to the browser)
MAMP_PORT=8888

# Axios request timeout in milliseconds
VITE_API_TIMEOUT=15000

# localStorage key used by Zustand auth persist middleware
VITE_AUTH_STORAGE_KEY=cur-mis-auth

# API Documentation Link (Dev Mode only)
VITE_API_DOCS_URL=http://localhost:8888/cur-mis/backend/public/api-docs.php

# Sub-folder base for the React app and React Router (no trailing slash)
VITE_BASE_PATH=/umis