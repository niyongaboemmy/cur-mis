# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# Keys marked REQUIRED are checked at boot (backend/public/index.php) and the
# app refuses to start without them.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CurMis
APP_ENV=local                  # REQUIRED — local | production
APP_DEBUG=true                 # MUST be false in production
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5180
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1              # REQUIRED
DB_PORT=3306
DB_DATABASE=curac_save         # REQUIRED
DB_USERNAME=root               # REQUIRED
DB_PASSWORD=                   # REQUIRED (may be empty on a default XAMPP install)
DB_CHARSET=utf8mb4

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED — never reuse across environments
JWT_EXPIRY=28800

CORS_ALLOWED_ORIGINS=http://localhost:5180

# ── File storage service ──────────────────────────────────────────────────────
# The standalone file-server that stores profile photos, applicant documents and
# payment slips. Uploads fail with HTTP 502 if these are wrong or unreachable.
#
#   FILE_SERVER_URL points at the file-server's PUBLIC directory, with no
#   trailing slash. It must match how the service is actually being served:
#     start-fileserver.bat (php -S)  ->  http://127.0.0.1:9001
#     Apache / XAMPP                 ->  http://localhost/cur-mis/file-server/public
#     cPanel / production            ->  https://your-domain/path-to/file-server/public
#
#   FILE_SERVER_KEY must be BYTE-IDENTICAL to FILE_SERVER_KEY in file-server/.env.
#   A mismatch makes the storage service answer 401 and every upload fail.
#
# Verify both with:  GET /api/health?deep=1
#   -> {"file_server":{"configured":true,"reachable":true}}   is what you want.
FILE_SERVER_URL=http://127.0.0.1:9001
FILE_SERVER_KEY=development_key_change_me

# ── Mail ──────────────────────────────────────────────────────────────────────
# Verified production values (Sep 2026):
#   MAIL_HOST=cpanel.cur.ac.rw  MAIL_PORT=465  MAIL_ENCRYPTION=ssl  (587/tls also works)
#   MAIL_USERNAME / MAIL_FROM_ADDRESS = curmis@cur.ac.rw
# Do NOT use mail.cur.ac.rw — its DNS A record points to a different cPanel server
# (197.243.30.87) that does not hold the curmis@ mailbox, so auth fails with
# "535 Incorrect authentication data". cpanel.cur.ac.rw (197.243.30.91) is the box
# that actually hosts the account.
# The server's backend/.env is NOT deployed by CI — edit it by hand, then verify with:
#   php scripts/test_mail.php you@example.com .env
MAIL_DRIVER=smtp
MAIL_HOST=cpanel.cur.ac.rw
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=no-reply@cur.ac.rw
# true is currently required: the TLS certificate on cpanel.cur.ac.rw does not match
# that hostname, so strict verification fails. Set false once the host/cert is fixed.
MAIL_SSL_BYPASS=true

# ── API ───────────────────────────────────────────────────────────────────────
API_DOCS_PUBLIC=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# ── Institution (used on generated PDFs) ──────────────────────────────────────
INSTITUTION_NAME=
REGISTRAR_NAME=
REGISTRAR_TITLE=
INSTITUTION_ADDRESS=
INSTITUTION_WEBSITE=
INSTITUTION_EMAIL=
INSTITUTION_PHONE=

# ── Third party ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
URUBUTOPAY_MERCHANT_CODE=
URUBUTOPAY_CHECKOUT_URL=
URUBUTOPAY_APPLICATION_FEE=36000    # Application processing fee in RWF
URUBUTOPAY_DEBUG_LOG=false

# Starting password for a login account created alongside a staff record in HR.
# Shared and publicly known, so accounts are flagged must_change_pw = 1 and the
# staff member should change it at first sign-in. Defaults to "staff123".
STAFF_DEFAULT_PASSWORD=staff123
