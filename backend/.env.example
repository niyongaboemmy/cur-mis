# ── Application Configuration ──────────────────────────────────────────────────
APP_NAME=CurMis
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8888/cur-mis/backend/public
APP_VERSION=1.0.0

# ── Database Configuration ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
# Note: For MAMP (macOS), default port is usually 8889. For XAMPP/WAMP (Windows), 3306.
DB_PORT=3306
DB_DATABASE=cur_mis
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4

# ── Security & Auth ────────────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRY=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Mail Configuration ────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=mail.hts.rw
MAIL_PORT=587
MAIL_USERNAME=info@hts.rw
MAIL_PASSWORD=secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@hts.rw
MAIL_FROM_NAME="${APP_NAME} API"
MAIL_REPLY_TO=no-reply@cur.ac.rw

# Set to true to bypass strict SSL (useful for some specific SMTP servers)
MAIL_SSL_BYPASS=true

# ── System Settings ───────────────────────────────────────────────────────────
API_DOCS_PUBLIC=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── File Server Configuration ──────────────────────────────────────────────────
FILE_SERVER_URL=http://localhost:8888/cur-mis/file-server/public
FILE_SERVER_KEY=change_me

# ── Institutional Branding (used in admission letters / emails) ───────────────
INSTITUTION_NAME="Catholic University of Rwanda"
REGISTRAR_NAME="Dr. Jane Doe"
REGISTRAR_TITLE="Academic Registrar"
INSTITUTION_ADDRESS="KN 78 Street, Kigali, Rwanda"
INSTITUTION_WEBSITE=www.ur.ac.rw
INSTITUTION_EMAIL=admissions@ur.ac.rw
INSTITUTION_PHONE="+250 788 000 000"
