<IfModule mod_rewrite.c>
    RewriteEngine On
    # IMPORTANT: Update this to match your deployment path:
    # - Local development: RewriteBase /cur-mis/
    # - Production: RewriteBase /umis/
    RewriteBase /umis/

    # Pass through for existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route /api/* requests to api.php (which delegates to backend)
    RewriteRule ^api/(.*)$ api.php [QSA,L]

    # Route everything else to frontend (React Router)
    RewriteRule ^ frontend/dist/index.html [QSA,L]
</IfModule>

