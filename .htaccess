<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite actual files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # CRITICAL: Pass through api-router.php itself (do NOT route to frontend)
    RewriteRule ^api-router\.php$ - [L]

    # Route ALL /api/* requests to api-router.php FIRST (highest priority)
    # This handles: /umis/api/*, /cur-mis/api/*, etc.
    RewriteRule ^umis/api/(.*)$ /api-router.php [QSA,L]
    RewriteRule ^cur-mis/api/(.*)$ cur-mis/api-router.php [QSA,L]

    # Route /umis/* to React frontend (all other requests that aren't files/dirs)
    RewriteRule ^umis/.*$ umis/index.html [QSA,L]

    # Route /cur-mis/* to React frontend (for local development)
    RewriteRule ^cur-mis/.*$ cur-mis/frontend/dist/index.html [QSA,L]
</IfModule>

# Security: Prevent direct access to sensitive files
<FilesMatch "\.(env|json|lock|log|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>


