<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /cur-mis/

    # Pass through for existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

