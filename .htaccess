<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /cur-mis/

    # Pass through existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Pass API requests to the backend/public directory which will handle routing
    # Pass the original path as a query parameter that the router can use
    RewriteRule ^api/(.*)$ backend/public/index.php?_original_path=/api/$1 [QSA,L]
</IfModule>
