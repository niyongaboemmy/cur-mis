# Large local DB dumps (do not commit — exceed GitHub 100MB limit)
curac_cur_mis(Iyabo).sql

# Local working data dumps in repo root (legacy exports used for migrations, not code).
# Root-only glob so it never touches backend/database/migrations/*.sql.
/*.sql

# Live-server DB exports dropped into database/ (e.g. "curac_save db.sql").
# Only files directly in database/ — database/migrations/*.sql stays tracked.
/database/*.sql

# Handover deliverables and one-off reports (not application code).
deliverables/
IDENTITY_CONSOLIDATION_REPORT.md
curac_save.sql
curac_save.sql
