Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /umis/

# Don't rewrite actual files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route /api/* requests to api-router.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/umis/api/
RewriteRule ^(.*)$ api-router.php [QSA,L]

# Route all other non-file/non-dir requests to index.html (SPA routing)
RewriteRule ^ index.html [QSA,L]

# Correct MIME type for ES modules
<IfModule mod_mime.c>
    AddType application/javascript   .js .mjs
    AddType text/css                 .css
    AddType image/svg+xml            .svg .svgz
    AddType image/webp               .webp
    AddType font/woff2               .woff2
    AddType font/woff                .woff
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|png|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Security: Pass Authorization header
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<FilesMatch "\.(env|json|lock|log|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>
