{
    "name": "cur-mis/file-server",
    "description": "Secure file storage and management service.",
    "type": "project",
    "require": {
        "php": ">=8.1.0",
        "vlucas/phpdotenv": "^5.5",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "FileServer\\": "core/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.34"
        },
        "audit": {
            "block-insecure": false
        }
    }
}
